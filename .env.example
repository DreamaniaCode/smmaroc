# Database URL (PostgreSQL for production / Docker Coolify)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=smmaroc"

# JWT Secret - MUST be changed in production to a secure 64-char random string!
JWT_SECRET="generate-a-strong-random-secret-key-min-32-chars-for-production"

# Initial Super Admin (Define your own secure credentials on first setup)
ADMIN_INITIAL_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="ChooseAStrongAdminPassword!2026"

# Telegram Bot Alerts & 2FA Notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Redis Queue (For background jobs)
REDIS_URL="redis://127.0.0.1:6379"
