datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  name                  String
  passwordHash          String
  role                  String           @default("USER") // SUPER_ADMIN | ADMIN | SUPPORT | USER
  balance               Decimal          @default(0) @db.Decimal(24, 10)
  currency              String           @default("MAD")
  apiKey                String?          @unique

  // Security & 2FA
  twoFactorSecret       String?          // Base32 TOTP Secret
  twoFactorEnabled      Boolean          @default(false)
  twoFactorBackupCodes  String?          // Comma-separated backup recovery codes
  lastLoginAt           DateTime?
  lastLoginIp           String?
  failedLoginAttempts   Int              @default(0)
  lockoutUntil          DateTime?
  forcePasswordChange   Boolean          @default(false)

  // CRM fields
  phone                 String?          // WhatsApp / Phone
  telegram              String?
  company               String?
  tier                  String           @default("STANDARD") // STANDARD | VIP | RESELLER | AGENCY
  status                String           @default("ACTIVE")   // ACTIVE | SUSPENDED | BANNED
  customDiscountPercent Decimal          @default(0) @db.Decimal(5, 2)
  adminNotes            String?          @db.Text
  crmNotes              CrmNote[]

  orders                Order[]
  deposits              Deposit[]
  supportRequests       SupportRequest[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@map("users")
}

model CrmNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("crm_notes")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String   // LOGIN, FAILED_LOGIN, PASSWORD_CHANGE, 2FA_ENABLE, WALLET_ADJUST, STAFF_CREATE, etc.
  targetType String?  // USER, DEPOSIT, SERVICE, PROVIDER, BLOG, SETTING
  targetId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

model BlogPost {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  excerpt        String    @db.Text
  content        String    @db.Text
  coverImage     String?
  category       String    // Instagram, TikTok, YouTube, Facebook, Guides, E-commerce
  tags           String?   // Comma-separated
  authorName     String    @default("Équipe SMMaroc")
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  viewsCount     Int       @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model Client {
  id        String   @id @default(uuid())
  name      String   @unique
  email     String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Provider {
  id              String           @id @default(uuid())
  name            String
  apiUrl          String // e.g. "https://justanotherpanel.com/api/v2"
  apiKey          String // Provider API key
  balance         Decimal          @default(0) @db.Decimal(24, 10)
  currency        String           @default("USD")
  lowBalanceLimit Decimal          @default(20) @db.Decimal(24, 10)
  isActive        Boolean          @default(true)
  lastCheckedAt   DateTime?
  orders          Order[]
  primaryMappings ServiceMapping[] @relation("PrimaryProvider")
  backupMappings  ServiceMapping[] @relation("BackupProvider")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("providers")
}

model Service {
  isActive           Boolean         @default(true)
  id                 String          @id @default(uuid())
  name               String
  category           String // e.g. "Instagram Followers", "YouTube Views"
  minQuantity        Int             @default(10)
  maxQuantity        Int             @default(100000)
  ratePer1000        Decimal         @default(0) @db.Decimal(24, 10)
  sellingRatePer1000 Decimal         @default(0) @db.Decimal(24, 10)
  dripFeedAllowed    Boolean         @default(false)
  mapping            ServiceMapping?
  orders             Order[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("services")
}

model ServiceMapping {
  id        String  @id @default(uuid())
  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  primaryProviderId String
  primaryProvider   Provider @relation("PrimaryProvider", fields: [primaryProviderId], references: [id], onDelete: Cascade)
  primaryServiceId  String // ID in upstream provider (e.g. "124")

  backupProviderId String?
  backupProvider   Provider? @relation("BackupProvider", fields: [backupProviderId], references: [id], onDelete: SetNull)
  backupServiceId  String? // ID in backup provider (e.g. "532")

  autoFailover Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([primaryProviderId, primaryServiceId])
  @@map("service_mappings")
}

model Order {
  id           String  @id @default(uuid())
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerCost Decimal @default(0) @db.Decimal(24, 10)
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  link         String
  quantity     Int

  // Drip-feed / Interval Scheduling
  runs            Int @default(1)
  intervalMinutes Int @default(0)
  completedRuns   Int @default(0)

  // Upstream Routing & Execution
  currentProviderId String?
  currentProvider   Provider? @relation(fields: [currentProviderId], references: [id], onDelete: SetNull)
  providerOrderId   String? // ID returned by provider API

  status     String  @default("PENDING") // PENDING | PROCESSING | IN_PROGRESS | COMPLETED | PARTIAL | CANCELED | FAILED
  startCount Int?
  remains    Int?
  charge     Decimal @default(0) @db.Decimal(24, 10)

  // Failover Tracking
  failoverAttempted Boolean @default(false)
  failoverReason    String?

  // Intake Source
  source        String @default("MANUAL") // MANUAL | MASS | CSV | GOOGLE_SHEETS
  sheetRowIndex Int? // Row index in Google Sheet if synced

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model Deposit {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(24, 10)
  currency      String   @default("MAD")
  method        String
  reference     String?
  status        String   @default("PENDING")
  adminNotes    String?
  feeAmount     Decimal  @default(0) @db.Decimal(24, 10)
  paidAmount    Decimal? @db.Decimal(24, 10)
  paymentTiming String   @default("STANDARD")
  proofFilename String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@map("deposits")
}

model SupportRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("support_requests")
}
